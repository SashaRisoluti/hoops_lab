# Copy this file to .env and adjust the values.
# Every variable is read via os.getenv() with a safe default (see hoops_lab/config.py),
# so the project also runs with no .env at all (e.g. on HuggingFace Spaces,
# where these are configured as Space Secrets instead).

# --- nba_api ---------------------------------------------------------------
# Per-request timeout (seconds) and minimum delay between consecutive calls
# (stats.nba.com rate limiting — do not go below 0.6).
NBA_API_TIMEOUT=30
NBA_API_DELAY=0.6

# --- Storage ----------------------------------------------------------------
DB_PATH=data/db/hoops_lab.duckdb

# --- Runtime ----------------------------------------------------------------
# "production" disables features that require live API calls (HF Spaces demo).
ENVIRONMENT=development

# --- Analysis defaults -------------------------------------------------------
# Reference team used for initial testing and (later) as "my team" in scouting.
# TO SWAP TEAMS: replace the value with any NBA full name as it appears on
# stats.nba.com, e.g. "Boston Celtics" or "Oklahoma City Thunder".
# The name is resolved to a team id at runtime via
# NBAApiClient.team_id_from_name() — no other change needed.
REFERENCE_TEAM=Dallas Mavericks

# Seasons pre-loaded for the public demo (comma-separated).
DEMO_SEASONS=2021-22,2022-23,2023-24,2024-25,2025-26
