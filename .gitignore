# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets & local config
.env
.streamlit/secrets.toml

# IDE preview exports
README.html
README_files/

# Locally downloaded team logos (the app hotlinks the NBA CDN instead;
# trademarked assets stay out of the public repo)
logos/

# Data: raw downloads and local DuckDB files are rebuilt from code.
# data/processed/ (Parquet) IS versioned — it feeds the HuggingFace Spaces demo.
data/raw/*
!data/raw/.gitkeep
data/db/*
!data/db/.gitkeep
*.duckdb

# Web app build artefacts. web/tokens.json and web/public/data/ ARE versioned —
# they are generated by scripts/export_web_data.py and consumed at build time.
web/node_modules/
web/.next/
web/out/
web/.vercel/
